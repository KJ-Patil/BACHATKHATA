<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_clay_card"
    android:backgroundTint="@color/colorBackground"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:alpha="0.35"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/txtBarDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_by_category"
        android:textColor="@color/colorTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Search over every income and expense bar. Always visible, so the sheet opens
         ready to search; the results list below only appears once it is in use. -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/ClayInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/chart_search_categories"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/colorTextSecondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCategorySearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/colorTextPrimary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Results. Swaps in over the chart while searching. -->
    <FrameLayout
        android:id="@+id/panelCategoryResults"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_3d"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/txtCategoryEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/chart_no_match"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtBarDetailHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:text="@string/chart_swipe_hint"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_3d"
        android:padding="4dp">

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChartDetail"
            android:layout_width="match_parent"
            android:layout_height="300dp" />
    </FrameLayout>

    <!-- Horizontal scrollbar for the chart. The 28dp height is the touch target;
         the track and thumb inside are the visible 6dp bar. -->
    <FrameLayout
        android:id="@+id/chartScrollBar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_scroll_track" />

        <View
            android:id="@+id/chartScrollThumb"
            android:layout_width="48dp"
            android:layout_height="6dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_scroll_thumb" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBarDetailClose"
        style="@style/ClayButtonSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/action_close" />

</LinearLayout>
