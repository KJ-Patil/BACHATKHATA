<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules (API 30 and below; API 31+ uses data_extraction_rules.xml).
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
       BachatKhata_Prefs_Enc is written by EncryptedSharedPreferences, whose AES key
       lives in the AndroidKeyStore. Keystore keys are hardware-bound and are NOT
       part of a backup, so a restored copy of this file cannot be decrypted on the
       new device: EncryptedSharedPreferences.create() throws, and every later call
       throws too, permanently.

       Excluding it means a restored install starts with no local settings and
       re-syncs the PIN state from Firestore, which is the recoverable outcome.
       Including it means a file that can never be opened again.
    -->
    <exclude domain="sharedpref" path="BachatKhata_Prefs_Enc.xml" />
</full-backup-content>
