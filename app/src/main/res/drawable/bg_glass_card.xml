<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism card — translucent fill with a light border, no shadow strip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glassCardBg" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/glassCardBorder" />
</shape>
