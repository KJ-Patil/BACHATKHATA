rules_version = '2';

// Bachat Khata — Firestore security rules.
//
// Two access models only:
//   1. users/{uid}/**  — strictly private to the owner. Everything the app stores
//      per person lives here: transactions, budgets, savings_goals, categories,
//      customers, customer_txns, emis, bills, subscriptions, assets, liabilities,
//      net_worth_snapshots, mood_logs, notifications, backups.
//   2. groups/{groupId} — the ONLY genuinely shared, multi-user surface
//      (Family Wallet, Org Donations, Expense Claims, Event Funds, Bill Splitter).
//      Authorization is always on `memberUids` (real Firebase UIDs), never on
//      `members[].name` — display names are neither unique nor trustworthy.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. Per-user private data ────────────────────────────────────────────
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── 2. Shared group wallets ─────────────────────────────────────────────

    // Membership of the PARENT group doc, for use inside subcollections.
    function isGroupMember(groupId) {
      return request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    match /groups/{groupId} {

      function isMember() {
        return request.auth != null
            && request.auth.uid in resource.data.memberUids;
      }

      // The only top-level fields any member may change. Everything else —
      // id, createdBy, createdAt, inviteCode, type — is fixed at creation, so a
      // group cannot be repointed or re-identified after the fact.
      //
      // Each entry is written by a real screen: members/memberUids (join, leave),
      // memberLimits (GroupDetailActivity), balance (AddTransactionActivity and
      // OrgExpenseClaimsActivity), eventTargetBudget (EventFundActivity),
      // donationCounter (OrgDonationTrackerActivity), name (rename).
      function memberWritableFields() {
        return ['members', 'memberUids', 'memberLimits', 'balance',
                'eventTargetBudget', 'donationCounter', 'name'];
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // An existing member editing the group. Two limits, both absent before:
      // only the fields above may move, and a member may drop only THEMSELF from
      // the roster. Leaving is self-removal; evicting someone else is not, and the
      // old rule allowed any member to empty memberUids entirely. The creator is
      // exempt so an admin can still remove a member.
      function isMemberUpdate() {
        return isMember()
            && changedKeys().hasOnly(memberWritableFields())
            && (request.auth.uid == resource.data.createdBy
                || request.resource.data.memberUids.hasAll(
                     resource.data.memberUids.removeAll([request.auth.uid])));
      }

      // Someone joining with an invite code. This is the only write a non-member
      // may make, and it has to be exactly "append me and nothing else".
      //
      // The old rule asked only whether the uid appeared in the RESULT, which any
      // signed-in user could satisfy while rewriting the document around it: send
      // memberUids: [me] and every existing member is evicted, with name, balance
      // and members free to change in the same write. Requiring the new array to
      // equal the old one plus this uid makes eviction unexpressible.
      //
      // `members` is display-only — the header note above applies, authorization
      // never reads it — so growth by one entry is all that is checked there.
      function isSelfJoin() {
        return request.auth != null
            && !(request.auth.uid in resource.data.memberUids)
            && changedKeys().hasOnly(['members', 'memberUids'])
            && request.resource.data.memberUids ==
                 resource.data.memberUids.concat([request.auth.uid])
            && request.resource.data.members.size() ==
                 resource.data.members.size() + 1;
      }

      // Read a single group you belong to.
      allow get: if isMember();

      // Queries. This permits exactly one shape:
      //     collection("groups").whereArrayContains("memberUids", uid)
      // which is what the Family Wallet dashboard issues. Any broader query —
      // including an unfiltered fetch of the collection — is rejected, so the
      // groups collection can never be enumerated by a stranger.
      allow list: if isMember();

      // A new group starts with its creator and nobody else. Seeding memberUids
      // with other people's uids would push an unrequested group into their
      // Family Wallet list, so the roster has to start as just the author.
      // Invited contacts live in `members` with a blank uid until they join.
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.memberUids.hasOnly([request.auth.uid])
                    && request.auth.uid in request.resource.data.memberUids;

      allow update: if isMemberUpdate() || isSelfJoin();

      // Deleting destroys the shared history for everyone, so it is allowed only
      // once nobody else is left — which is exactly when GroupDetailActivity
      // offers it (the Leave dialog switches to Delete for the last member).
      // Previously any one member could erase a group the others were still using.
      allow delete: if isMember() && resource.data.memberUids.size() == 1;

      // All shared subcollections inherit the parent's membership check:
      // group_transactions, expense_claims, projects, donations,
      // event_expenses, event_contributions, split_sessions.
      match /{document=**} {
        allow read, write: if isGroupMember(groupId);
      }
    }

    // ── 3. Invite-code lookup ───────────────────────────────────────────────
    //
    // Joining needs to resolve a 6-digit code to a group WITHOUT being able to
    // read or enumerate groups you're not in yet. A single-document lookup does
    // that: `get` on a known code is allowed, `list` never is.
    //
    // Each doc is  inviteCodes/{code} -> { groupId: "<auto-id>" }
    //
    // Written by CreateGroupActivity.publishInviteCode, read by
    // FamilyWalletFragment.joinGroupWithInviteCode.
    // NOTE ON CODE STRENGTH: a code is the sole credential for joining, and `get`
    // is open to any signed-in user, so the secrecy of the code is the only thing
    // protecting a group's data. Rules cannot help here — they cannot rate-limit,
    // and they cannot tell a guessed document id from one a friend shared. The
    // only defence is entropy, which lives in CreateGroupActivity.generateInviteCode.
    //
    // Codes were six DIGITS: a 1,000,000-key space, cheap to walk exhaustively,
    // which made this collection a directory of every groupId in the app. They are
    // now six characters from a 32-symbol alphabet — ~1.07e9, three orders of
    // magnitude more — while staying the same length to type.
    //
    // Six-digit codes issued before that change still resolve (they are looked up
    // by document id) and are still weak. Reissue them if that matters.
    match /inviteCodes/{code} {
      allow get:    if request.auth != null;
      allow list:   if false;
      allow create: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberUids;

      // No update. The mapping is write-once: nothing in the app rewrites a live
      // code, and allowing it would let a member of group A repoint a code at
      // group B, silently redirecting everyone who already holds that code.
      // CreateGroupActivity's collision path relies on this — its set() on a code
      // that already exists is an update, and being denied is what makes it report
      // the code as unshareable instead of hijacking the existing mapping.
      allow update: if false;

      allow delete: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUids;
    }
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// DEPLOY ORDER — the backfill must run before these rules take effect.
//
// Joining used to be `collection("groups").whereEqualTo("inviteCode", code)`, a
// LIST operation over groups the user does not belong to. `allow list` above
// denies it: rules cannot inspect a query's filter value, so there is no way to
// express "allow this query only if you already know the code" — the lookup has
// to be a single-document read, which is what inviteCodes/ provides.
//
// The client side is done (CreateGroupActivity + FamilyWalletFragment). What
// remains is data: groups created before this change have no inviteCodes/ doc,
// so their codes resolve to nothing.
//
//   1. node scripts/backfill-invite-codes.js --dry-run   (review collisions)
//   2. node scripts/backfill-invite-codes.js
//   3. firebase deploy --only firestore:rules
//   4. Ship the app update. Older installs still run the denied query, so
//      joining fails there until users update — creating and using existing
//      groups is unaffected.
// ─────────────────────────────────────────────────────────────────────────────
